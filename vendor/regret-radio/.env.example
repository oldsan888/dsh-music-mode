# Vendored Regret-radio backend — env template (no secrets).
# Optional: copy to ./data/.env (relative to the vendored package root, where
# the hosted backend runs) to override defaults. The DSH music-mode host plugin
# spawns this backend and supplies PORT via the child env; the pure-music core
# needs no other secrets.

# Server
SERVER_HOST=127.0.0.1
# PORT is set by the DSH host plugin (spawn env). Override here only for manual runs.

# Required only to persist NetEase/QQ login cookies across restarts. Generate a
# unique 64-hex-character value and keep it outside version control. Without it,
# login cookies remain in memory for the current backend process only.
# RUNTIME_CONFIG_MASTER_KEY=

# SQLite data dir (relative to cwd = this vendor package root)
SQLITE_PATH=./data/regret-radio.db
BEAT_CACHE_DIR=./data/beatmaps
NETEASE_COOKIE_FILE=./data/.cookie
QQ_COOKIE_FILE=./data/.qq-cookie
DATA_DIR=./data

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIR=./data/logs
# Disabled by default. Enable only for direct local-backend troubleshooting.
DEBUG_LOG_ENDPOINT=false

# Music sources (default all on)
MUSIC_NETEASE_ENABLED=true
MUSIC_QQ_ENABLED=true
MUSIC_DEFAULT_QUALITY=hires
MEDIA_PROXY_ALLOWLIST=music.126.net,music.163.com,126.net,qq.com,qpic.cn,gtimg.cn,qqmusic.qq.com

# AI layer — deliberately OFF for the pure-music core (阿呆 is the brain).
# Leave these empty unless the slim build keeps TTS.
# API_KEY=
# API_BASE_URL=
# LLM_MODEL=
# EMBEDDING_API_KEY=
# VOICE_MODE=
# VOICE_PRESET=
# VOICE_REF_AUDIO=
